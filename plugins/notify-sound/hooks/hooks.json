{
    "description": "Play a completion sound when Claude finishes a turn.",
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node -e \"const os=require('os'),cp=require('child_process');const p=os.platform();if(process.env.CLAUDE_HOOK_SOUND==='off')process.exit(0);try{if(p==='darwin')cp.spawn('afplay',['/System/Library/Sounds/Glass.aiff'],{stdio:'ignore',detached:true}).unref();else if(p==='win32')cp.spawn('powershell',['-NoProfile','-c','[System.Media.SystemSounds]::Asterisk.Play()'],{stdio:'ignore',detached:true}).unref();else cp.spawn('paplay',['/usr/share/sounds/freedesktop/stereo/complete.oga'],{stdio:'ignore',detached:true}).unref();}catch(e){process.stdout.write('\\u0007');}\"",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}
